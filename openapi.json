{
  "openapi": "3.1.0",
  "info": {
    "title": "SoldFetch eBay API",
    "version": "1.0.0",
    "description": "SoldComps-compatible core paths with documented limitations. Verified sale-date filters, accepted-offer hydration, and emailed exports are unavailable. All REST aliases require a SoldFetch API key."
  },
  "servers": [
    {
      "url": "https://soldfetch.com"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/scrape": {
      "get": {
        "operationId": "search",
        "summary": "Sold listings",
        "description": "One upstream call per request. Up to 200 results. Unverified sale dates and displayed listing prices are explicitly marked. Successful responses consume one request; failed responses do not.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "sony wh-1000xm5"
            }
          },
          {
            "name": "ebaySite",
            "in": "query",
            "description": "Regional eBay site; availability is listed in capabilities.",
            "schema": {
              "type": "string",
              "enum": [
                "ebay.com",
                "ebay.co.uk",
                "ebay.de",
                "ebay.fr",
                "ebay.it",
                "ebay.es",
                "ebay.ca",
                "ebay.com.au"
              ],
              "default": "ebay.com"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "0"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 1
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 60
            }
          },
          {
            "name": "sold",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "itemCondition",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "new",
                "used"
              ],
              "default": "any"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "endedRecently",
                "timeNewlyListed",
                "pricePlusPostageLowest",
                "pricePlusPostageHighest"
              ],
              "default": "endedRecently"
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "buyingFormat",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "auction",
                "buyItNow",
                "acceptsOffers"
              ],
              "default": "all"
            }
          },
          {
            "name": "exactMatch",
            "in": "query",
            "description": "Exclude explicitly marked loose matches. Does not guarantee product identity.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized eBay response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
